# ─────────────────────────────────────────────────────────────────────────────
#  OPTIONAL.
#
#  You do not need this file to run SilentShift locally — `./start.sh` works with
#  no configuration at all, and caches a signing key so you stay logged in across
#  restarts.
#
#  Copy it to `.env` only when you want to override something, or when deploying:
#  production refuses to start until SECRET_KEY, FIRST_SUPERUSER_PASSWORD and
#  CORS_ORIGINS are set explicitly.
# ─────────────────────────────────────────────────────────────────────────────

# ---------------------------------------------------------------- application
ENVIRONMENT=local            # local | staging | production | test
DEBUG=false
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console           # console | json  (use json in production)
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ------------------------------------------------------------------- security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-48-byte-urlsafe-string-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

FIRST_SUPERUSER_EMAIL=admin@silentshift.io
FIRST_SUPERUSER_PASSWORD=ChangeMe_S1lentShift!
AUTO_SEED=true               # seed the demonstration estate on first start

CORS_ORIGINS=http://localhost:5173,http://localhost:8000
TRUSTED_HOSTS=*

# ----------------------------------------------------------------- persistence
# Leave POSTGRES_HOST unset to fall back to local SQLite (zero-dependency dev).
# POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=silentshift
POSTGRES_PASSWORD=silentshift
POSTGRES_DB=silentshift
SQLITE_PATH=./silentshift.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/db   # overrides the above
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Optional. Enables cross-replica fan-out for the live WebSocket feed.
# REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------------------- observability
METRICS_ENABLED=true
# SENTRY_DSN=

# --------------------------------------------------------------- rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_INGEST_REQUESTS=2000

# ------------------------------------------------------------ detection engine
DECAY_HALFLIFE_HOURS=48
THRESHOLD_EARLY_DRIFT=28
THRESHOLD_ESCALATING=50
THRESHOLD_CRITICAL=75
RECOMPUTE_INTERVAL_SECONDS=45
RETENTION_DAYS=90

# ------------------------------------------------------------------- frontend
SERVE_FRONTEND=true
FRONTEND_DIST_DIR=../frontend/dist
